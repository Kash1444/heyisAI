# ── App ────────────────────────────────────────────
APP_NAME=Personal AI Memory Assistant
APP_ENV=development
DEBUG=True
SECRET_KEY=change-me-in-production

# ── Gmail OAuth ────────────────────────────────────
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Gemini ─────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ── Backup Providers ───────────────────────────────
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# ── Database ───────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./gmail_chatbot.db

# ── Vector DB ──────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Email Ingestion ────────────────────────────────
MAX_EMAILS_TO_FETCH=500
EMAIL_CHUNK_SIZE=1000

# ── Telemetry ──────────────────────────────────────
ANONYMIZED_TELEMETRY=false
CHROMA_TELEMETRY=false

# ── Offline Model Settings ─────────────────────────
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1