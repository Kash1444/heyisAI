# App
APP_NAME=Gmail AI Assistant
APP_ENV=development
DEBUG=true
SECRET_KEY=my-local-dev-secret-key-change-in-prod

# Gmail OAuth (from Google Cloud Console)
GMAIL_CLIENT_ID=GMAIL_CLIENT_ID=your-actual-client-id-here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-actual-client-secret-here
GMAIL_REDIRECT_URI=http://localhost:8000/auth/callback

# Gemini (from Google AI Studio)
GEMINI_API_KEY=your-actual-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Database
DATABASE_URL=sqlite+aiosqlite:///./gmail_chatbot.db

# Vector DB
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Email Ingestion
MAX_EMAILS_TO_FETCH=500
EMAIL_CHUNK_SIZE=1000