# ── App ────────────────────────────────────────────
APP_NAME=Personal AI Memory Assistant
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# ── Gmail OAuth (Dharmaprakash) ────────────────────
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Gemini ─────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash


# ── Database ───────────────────────────────────────
DATABASE_URL=sqlite:///./disqry.db
=======
# Back up model
GROQ_API_KEY=gsk_your_key_here

# Database
DATABASE_URL=sqlite+aiosqlite:///./gmail_chatbot.db

# ── Vector DB (Dharmaprakash) ──────────────────────
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Email Ingestion ────────────────────────────────
MAX_EMAILS_TO_FETCH=500
EMAIL_CHUNK_SIZE=1000

# ── LLM Provider (Atharva) ─────────────────────────
LLM_PROVIDER=gemini
OPENAI_API_KEY=your-openai-api-key-if-used
HUGGINGFACE_API_KEY=your-hf-api-key-if-used